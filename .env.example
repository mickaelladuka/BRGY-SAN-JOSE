# Copy to .env.local (git-ignored) and adjust. Never put secrets here: every VITE_* value is public in the built bundle.
VITE_API_BASE_URL=http://localhost:5085
# Honoured ONLY by `npm run dev` (import.meta.env.DEV). The backend must ALSO enable it (EnableLocalDeviceBypass) or it does nothing.
VITE_ENABLE_LOCAL_DEVICE_BYPASS=false
# Shown on emergency screens. 911 is the Philippine national emergency hotline; add your barangay's local number if you have one.
VITE_EMERGENCY_HOTLINE=911
VITE_BARANGAY_HOTLINE=
